# SPA fallback for client-side routes (e.g. /invest/forex, /investments/abc).
# Hostinger Apache serves existing files/dirs first; everything else loads 200.html.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /200.html [L]
</IfModule>
